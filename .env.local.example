# ==========================================
# Nihi Studio WooCommerce Configuration
# ==========================================

# 1. Hostinger WordPress WooCommerce REST API endpoint URL
NEXT_PUBLIC_WOOCOMMERCE_API_URL=https://nihistudio.com

# 2. WooCommerce REST API Consumer Key & Secret
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# Razorpay Payment Gateway (UPI / Cards / NetBanking)
# ==========================================
# Generate keys at: https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# Hostinger Business Email SMTP (Emails & OTPs)
# ==========================================
SMTP_USER=care@nihistudio.com
SMTP_PASS=your_hostinger_email_password
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
